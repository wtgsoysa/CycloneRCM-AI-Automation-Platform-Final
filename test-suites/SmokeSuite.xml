<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CycloneRCM Smoke Suite" parallel="false" verbose="1" preserve-order="true">

    <!-- Centralized Report Listener for Consolidated Reporting -->
    <listeners>
        <listener class-name="com.cyclonercm.reporting.CentralizedReportListener"/>
    </listeners>

    <!-- Test execution order: Authentication FIRST, then File Management -->

    <test name="1. Authentication Smoke" preserve-order="true">
        <classes>
            <class name="com.cyclonercm.auth.tests.smoke.AuthenticationTest"/>
        </classes>
    </test>

    <test name="2. File Management Smoke" preserve-order="true">
        <classes>
            <class name="com.cyclonercm.files.tests.smoke.upload.FileuploadTest"/>
        </classes>
    </test>

</suite>
